#!/usr/bin/env bash
# ==============================================================================
# MishraShardendu22 Profile - Intelligent Pre-Commit Gate
# ==============================================================================
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "${REPO_ROOT}"

if [ -t 1 ]; then
    BOLD="\033[1m"
    DIM="\033[2m"
    RED="\033[1;31m"
    GREEN="\033[1;32m"
    YELLOW="\033[1;33m"
    BLUE="\033[1;34m"
    MAGENTA="\033[1;35m"
    CYAN="\033[1;36m"
    RESET="\033[0m"
else
    BOLD=""
    DIM=""
    RED=""
    GREEN=""
    YELLOW=""
    BLUE=""
    MAGENTA=""
    CYAN=""
    RESET=""
fi

START_TIME=$(date +%s)
FAILED_STEPS=()
PASSED_STEPS=()

print_banner() {
    echo -e "${CYAN}======================================================================${RESET}"
    echo -e "${BOLD}${MAGENTA}  MishraShardendu22 Profile - Pre-Commit Validation Gate${RESET}"
    echo -e "${CYAN}======================================================================${RESET}"
}

log_info() { echo -e "${BLUE}[INFO]${RESET} $*"; }
log_step() { echo -e "\n${BOLD}${CYAN}> [STEP]${RESET} ${BOLD}$*${RESET}"; }
log_pass() { echo -e "${GREEN}[PASS]${RESET} $*"; }
log_fail() { echo -e "${RED}[FAIL]${RESET} $*"; }

if [ "${SKIP_HOOKS:-0}" = "1" ] || [ "${PRECOMMIT_BYPASS:-0}" = "1" ]; then
    echo "Pre-commit validations bypassed."
    exit 0
fi

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)

print_banner
log_info "Running profile validation checks..."

run_step() {
    local step_name="$1"
    local cmd="$2"
    local remediation="$3"

    log_step "${step_name}"
    local step_start
    step_start=$(date +%s)

    if ( cd "${REPO_ROOT}" && eval "${cmd}" ); then
        local step_end
        step_end=$(date +%s)
        local elapsed=$((step_end - step_start))
        log_pass "${step_name} (${elapsed}s)"
        PASSED_STEPS+=("${step_name}")
    else
        local step_end
        step_end=$(date +%s)
        local elapsed=$((step_end - step_start))
        log_fail "${step_name} failed after ${elapsed}s"
        FAILED_STEPS+=("${step_name}")
        echo -e "\n${RED}${BOLD}Commit Aborted!${RESET} The step '${step_name}' did not pass."
        if [ -n "${remediation}" ]; then
            echo -e "${YELLOW}Suggested fix:${RESET} ${remediation}"
        fi
        exit 1
    fi
}

check_secrets() {
    local leaks=0
    if [ -n "${STAGED_FILES}" ]; then
        while IFS= read -r file; do
            [ -z "$file" ] && continue
            if [[ "$file" =~ (^|/)(\.env|\.env\.local|\.env\.staging|\.env\.production)$ ]] && ! [[ "$file" =~ \.example$ ]]; then
                echo -e "${RED}Error: Committing sensitive environment file:${RESET} ${file}"
                leaks=1
            fi
            if [[ "$file" =~ \.(pem|key|pkcs12|pfx|id_rsa|id_ed25519)$ ]]; then
                echo -e "${RED}Error: Committing private key or certificate file:${RESET} ${file}"
                leaks=1
            fi
        done <<< "${STAGED_FILES}"

        local staged_diff
        staged_diff=$(git diff --cached -U0 2>/dev/null || true)
        if echo "${staged_diff}" | grep -E -q '^\+[[:space:]]*(ghp_[A-Za-z0-9_]{36}|gho_[A-Za-z0-9_]{36}|sk-[A-Za-z0-9]{32,})'; then
            echo -e "${RED}Error: Potential API secret token detected in staged diff!${RESET}"
            leaks=1
        fi
    fi
    return $leaks
}

run_step "Secret & Sensitive File Scan" "check_secrets" "Unstage credentials using 'git restore --staged <file>'."

END_TIME=$(date +%s)
TOTAL_TIME=$((END_TIME - START_TIME))

echo -e "\n${CYAN}======================================================================${RESET}"
echo -e "${GREEN}${BOLD}[PASS] All Pre-Commit Validations Passed Successfully! (${TOTAL_TIME}s)${RESET}"
echo -e "${CYAN}======================================================================${RESET}\n"
exit 0
